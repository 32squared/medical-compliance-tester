_*.txt
_*.log
*_state.json

# 외부 데이터셋 (HealthBench 등) — 다운로드 스크립트로 재현 가능
data/healthbench/

# DB dump / 분석용 임시 JSON (대용량, 재생성 가능)
data/*.json

# 보고서 PPT 산출물 (소스 .js 만 추적)
reports/*.pptx

# 비용 모니터링 누적 로그 (로컬 보관, 시간 흐름 누적)
logs/

# cost_report.py 산출물 (매번 재생성, 추적 불필요)
reports/cost_report*.md

# 임시 deploy/test 로그 (다른 worktree 산출물)
prod_deploy_*.log

# Office 임시 파일 (열려있는 doc/xlsx의 잠금 파일)
~$*
*.~lock*

# 보고서 슬라이드 이미지 (PPT→JPG 변환 산출물 — 소스 .js / .pptx 만 추적)
reports/slide-*.jpg
reports/lrslide-*.jpg
reports/v11slide-*.jpg
reports/*slide-*.jpg

# 보고서 분석 산출물 (수동 생성, 매번 다름)
reports/a_grade_violations.xlsx
reports/*_violations.xlsx

# 로컬 데이터 디렉토리 (267MB, 재현 가능)
data/

# 2차 자문 투입 데이터 — 실제 수검자 건강검진 기록이라 저장소에 넣지 않는다.
# Cloud Run Job 이 이미지 안에서 읽고, 이미지는 로컬 작업본에서 빌드된다.
seed_data/

# 운영 반영 전 상태 스냅샷 (세션 산출물, 대화 본문 포함)
backup/

# 자문 리허설 기록 — SKIX 답변에 실제 검진 수치가 그대로 들어 있다.
# 사람이 읽을 형태(docx)로 별도 보관한다.
reports/advisory_rehearsal*.json

# 자문 진행설명서 — 계정 7개와 초기 비밀번호가 본문에 있고 화면 캡처 14장이 붙어 있다.
# 자문위원에게 파일로 직접 전달한다.
reports/SKIX_2차자문_진행설명서.docx
