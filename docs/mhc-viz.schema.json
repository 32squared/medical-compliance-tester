{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mhc-viz.schema.json",
  "title": "mhc-viz block v1",
  "description": "답변 시각 블록 규약 v1.0 (docs/mhc_viz_convention_v1_20261014.html 부록 A). 스키마 밖 규칙은 mhc_viz.py 가 검사한다.",
  "type": "object",
  "required": ["v", "kind", "title", "caption", "source"],
  "properties": {
    "v": { "const": 1 },
    "kind": { "enum": ["table", "line", "range", "timeline"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "caption": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source": {
      "type": "object",
      "required": ["data"],
      "properties": {
        "data": { "enum": ["phr.checkup", "phr.oral", "phr.cancer", "phr.prescription", "conversation", "literature"] },
        "ref": { "type": "string", "maxLength": 80 },
        "cite": { "type": "string", "pattern": "^\\[\\d+:\\d+\\]$" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "table" } } },
      "then": {
        "required": ["columns", "rows"],
        "properties": {
          "columns": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "maxLength": 30 } },
          "rows": { "type": "array", "minItems": 1, "maxItems": 20,
                    "items": { "type": "array", "items": { "type": ["string", "number", "null"] } } },
          "positions": { "type": "array", "maxItems": 20, "items": { "enum": ["in", "border", "above", "below"] } }
        } } },
    { "if": { "properties": { "kind": { "const": "line" } } },
      "then": {
        "required": ["unit", "series"],
        "properties": {
          "unit": { "type": "string", "maxLength": 12 },
          "series": { "type": "array", "minItems": 2, "maxItems": 8,
                      "items": { "type": "object", "required": ["date", "value"],
                                 "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                                                 "value": { "type": "number" } },
                                 "additionalProperties": false } },
          "reference": { "type": "object", "required": ["label"],
                         "properties": { "low": { "type": "number" }, "high": { "type": "number" },
                                         "label": { "type": "string", "maxLength": 30 } },
                         "anyOf": [ { "required": ["low"] }, { "required": ["high"] } ],
                         "additionalProperties": false }
        } } },
    { "if": { "properties": { "kind": { "const": "range" } } },
      "then": {
        "required": ["value", "unit", "bands"],
        "properties": {
          "value": { "type": "number" },
          "unit": { "type": "string", "maxLength": 12 },
          "bands": { "type": "array", "minItems": 2, "maxItems": 4,
                     "items": { "type": "object", "required": ["from", "to", "label"],
                                "properties": { "from": { "type": ["number", "null"] }, "to": { "type": ["number", "null"] },
                                                "label": { "type": "string", "maxLength": 30 } },
                                "additionalProperties": false } }
        } } },
    { "if": { "properties": { "kind": { "const": "timeline" } } },
      "then": {
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "minItems": 1, "maxItems": 10,
                     "items": { "type": "object", "required": ["label", "from", "to", "status"],
                                "properties": { "label": { "type": "string", "maxLength": 40 },
                                                "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                                                "to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                                                "status": { "enum": ["ongoing", "ended"] } },
                                "additionalProperties": false } }
        } } }
  ]
}
